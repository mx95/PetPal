# html5-qrcode publishes source maps that point at TypeScript files not included
# in the npm package, which makes react-scripts print noisy build warnings.
GENERATE_SOURCEMAP=false

# Show Bookings in bottom nav, top nav, and discover (set 0 to hide).
REACT_APP_BOOKINGS_BROWSE=1

# Google Analytics 4 (gtag) — loaded after cookie consent.
REACT_APP_GA_MEASUREMENT_ID=G-T0V10MEL5V
