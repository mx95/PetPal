rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Opt-in public walk stats: public read; only the owner can write their row.
    match /publicWalkStats/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Admin list: one document per admin UID (Firebase console, or scripts/add-admin.cjs + Admin SDK).
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Business / venue applications: user-owned; site owner approves in app (admin doc in /admins).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCompanyOwner(companyId) {
      return request.auth != null && request.auth.uid == companyId;
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function isApprovedCompany(companyId) {
      return isCompanyOwner(companyId) && companyDoc(companyId).data.status == 'approved';
    }

    /** True when this company is open for customer booking (used for services/availability reads + booking create). */
    function isPublicBookableCompany(companyId) {
      let p = get(/databases/$(database)/documents/providers/$(companyId));
      return p.exists && p.data.bookingEnabled == true;
    }

    match /companies/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.accountType == 'company'
        && request.resource.data.status == 'pending';
      // Owner may resubmit after rejection, or edit while still pending. Admins can set status / reviews.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && request.resource.data.status == 'pending'
            && (resource.data.status == 'pending' || resource.data.status == 'rejected'));
      allow delete: if false;

      // Provider service catalog (public read if booking-enabled + approved; owner/admin writes).
      match /services/{serviceId} {
        allow read: if request.auth != null && isPublicBookableCompany(userId);
        allow create, update, delete: if isAdmin() || isApprovedCompany(userId);
      }

      // Slot-based availability (public read if booking-enabled + approved; owner/admin writes).
      match /availability/{slotId} {
        allow read: if request.auth != null && isPublicBookableCompany(userId);
        allow create, update, delete: if isAdmin() || isApprovedCompany(userId);
      }

      // Provider-managed roster for walk-ins / unregistered dogs (private to provider/admin).
      match /clientPets/{petId} {
        allow read, create, update, delete: if isAdmin() || isApprovedCompany(userId);
      }
    }

    // App user profiles keyed by auth uid.
    // Needed for signup username/business-name availability checks.
    match /users/{userId} {
      // Signed-in users may read for availability checks.
      allow read: if request.auth != null;

      // Users can create only their own uid-keyed profile doc.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;

      // Users can update only their own uid-keyed profile doc.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // Pets: public read for NFC/public pet profile pages; owner-only writes.
      match /pets/{petId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;

        match /medications/{medId} {
          allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /billing/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Shop hardware entitlements (written by Cloud Functions after JCC return).
      match /shopEntitlements/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Bookings: top-level collection so customers and providers can query efficiently.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
            || resource.data.companyId == request.auth.uid
            || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.companyId is string
        && isPublicBookableCompany(request.resource.data.companyId)
        && request.resource.data.status == 'booked';

      // Customer can cancel their own booking; provider can manage status for their company bookings.
      allow update: if request.auth != null
        && (
          // Provider/admin
          isAdmin()
          || (resource.data.companyId == request.auth.uid)
          // Customer cancel only (keep immutable linkage)
          || (
            resource.data.customerUid == request.auth.uid
            && request.resource.data.customerUid == resource.data.customerUid
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.slotId == resource.data.slotId
            && request.resource.data.serviceId == resource.data.serviceId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    // Unique account/username reservation for race-safe signup.
    match /accountNames/{nameId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Public provider directory (one doc per approved company). Used for customer browse/search.
    match /providers/{companyId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() || isApprovedCompany(companyId);
      allow delete: if false;
    }

    // JCC payment sessions — Cloud Functions (Admin SDK) only.
    match /paymentSessions/{sessionId} {
      allow read, write: if false;
    }

    // Active subscriptions (renewed by scheduled Cloud Function).
    match /billingSubscriptions/{subId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Shop aggregate counters (written by Cloud Functions only).
    match /shopStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public profile docs used by NFC/QR pages (sanitized fields only).
    match /publicPets/{publicId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Stray / found pets available for adoption — visible to signed-in users; only reporter edits their doc.
    match /strayListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'available';
      allow update: if request.auth != null
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid == resource.data.reporterUid;
      allow delete: if false;
    }

    // Dog breeding listings — signed-in readers; owners update their docs only.
    match /breedingListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
