rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Opt-in public walk stats: public read; only the owner can write their row.
    match /publicWalkStats/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Admin list: one document per admin UID (Firebase console, or scripts/add-admin.cjs + Admin SDK).
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Business / venue applications: user-owned; site owner approves in app (admin doc in /admins).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /companies/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.accountType == 'company'
        && request.resource.data.status == 'pending';
      // Owner may resubmit after rejection, or edit while still pending. Admins can set status / reviews.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && request.resource.data.status == 'pending'
            && (resource.data.status == 'pending' || resource.data.status == 'rejected'));
      allow delete: if false;
    }

    // App user profiles keyed by auth uid.
    // Needed for signup username/business-name availability checks.
    match /users/{userId} {
      // Signed-in users may read for availability checks.
      allow read: if request.auth != null;

      // Users can create only their own uid-keyed profile doc.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;

      // Users can update only their own uid-keyed profile doc.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // Pets: private per-user collection.
      match /pets/{petId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Unique account/username reservation for race-safe signup.
    match /accountNames/{nameId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Stray / found pets available for adoption — visible to signed-in users; only reporter edits their doc.
    match /strayListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'available';
      allow update: if request.auth != null
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid == resource.data.reporterUid;
      allow delete: if false;
    }

    // Dog breeding listings — signed-in readers; owners update their docs only.
    match /breedingListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
