rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Opt-in public walk stats: public read; only the owner can write their row.
    match /publicWalkStats/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Admin list: one document per admin UID (Firebase console, or scripts/add-admin.cjs + Admin SDK).
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Business / venue applications: user-owned; site owner approves in app (admin doc in /admins).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCompanyOwner(companyId) {
      return request.auth != null
        && companyDoc(companyId).exists
        && companyDoc(companyId).data.ownerUid == request.auth.uid;
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function isApprovedCompany(companyId) {
      return isCompanyOwner(companyId) && companyDoc(companyId).data.status == 'approved';
    }

    function ownerHasApprovedCompany(ownerUid) {
      return request.auth != null
        && request.auth.uid == ownerUid
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.status == 'approved';
    }

    /** Provider has a public directory row (may still have bookings disabled). */
    function hasProviderListing(companyId) {
      return exists(/databases/$(database)/documents/providers/$(companyId));
    }

    /** True when this company is open for customer booking (used for booking create). */
    function isPublicBookableCompany(companyId) {
      let p = get(/databases/$(database)/documents/providers/$(companyId));
      return p.exists && p.data.bookingEnabled == true;
    }

    /** Customer online booking (pet owner or provider testing with a second account). */
    function isCustomerOnlineBooking() {
      return request.auth != null
        && request.resource.data.status == 'booked'
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (!('walkIn' in request.resource.data) || request.resource.data.walkIn != true)
        && isPublicBookableCompany(request.resource.data.companyId);
    }

    /** Signed-in business account operating their own provider portal (companyId == auth uid). */
    function isProviderSelf(companyId) {
      return request.auth != null && request.auth.uid == companyId;
    }

    /** Read services, availability rules, and slot data for booking UI. */
    function canReadProviderBookingData(companyId) {
      return isAdmin()
        || isApprovedCompany(companyId)
        || isPublicBookableCompany(companyId)
        || (request.auth != null && hasProviderListing(companyId))
        || isProviderSelf(companyId);
    }

    /** Write provider scheduling catalog (rules, slots, services). */
    function canManageProviderData(companyId) {
      return isAdmin() || isApprovedCompany(companyId) || isProviderSelf(companyId);
    }

    match /companies/{companyId} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.accountType == 'company'
        && request.resource.data.status == 'pending';
      // Owner may resubmit after rejection, or edit while still pending. Admins can set status / reviews.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && (resource.data.status == 'pending' || resource.data.status == 'rejected'));
      allow delete: if false;

      // Provider service catalog (owner reads while setting up; customers when listing exists).
      match /services/{serviceId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      // Slot-based availability (owner reads while setting up; customers when listing exists).
      match /availability/{slotId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, delete: if canManageProviderData(companyId);
        allow update: if canManageProviderData(companyId)
          || (
            request.auth != null
            && isPublicBookableCompany(companyId)
            && resource.data.status == 'open'
            && request.resource.data.status == 'blocked'
            && request.resource.data.bookingId is string
          );
      }

      match /availabilityRules/{ruleId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      match /availabilityOverrides/{overrideId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      match /vacations/{vacationId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      match /blockedPeriods/{blockId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      match /employees/{employeeId} {
        allow read: if canReadProviderBookingData(companyId);
        allow create, update, delete: if canManageProviderData(companyId);
      }

      // Provider-managed roster for walk-ins / unregistered dogs (private to provider/admin).
      match /clientPets/{petId} {
        allow read, create, update, delete: if canManageProviderData(companyId);
      }
    }

    // Reverse lookup: collar IMEI → pet owner (admin device registry).
    match /trackerImeiIndex/{imei} {
      allow read: if isAdmin() || request.auth != null;
      allow create, update: if isAdmin()
        || (request.auth != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.petId is string);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Collection-group queries on `pets` (admin IMEI registry, etc.).
    match /{path=**}/pets/{petId} {
      allow read: if true;
    }

    // App user profiles keyed by auth uid.
    // Needed for signup username/business-name availability checks.
    match /users/{userId} {
      // Signed-in users may read for availability checks.
      allow read: if request.auth != null;

      // Users can create only their own uid-keyed profile doc.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;

      // Users can update only their own uid-keyed profile doc.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // Pets: public read for NFC/public pet profile pages; owner-only writes.
      match /pets/{petId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;

        match /medications/{medId} {
          allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /billing/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Shop hardware entitlements (written by Cloud Functions after JCC return).
      match /shopEntitlements/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Per-tracker monthly subscriptions (one doc per collar subscription).
      match /trackerSubscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /cancelRequests/{requestId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /shopOrders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }

      // Per-user read state for admin broadcast inbox.
      match /inboxReads/{messageId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Admin announcements — all signed-in users can read; only admins can publish.
    match /broadcastMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Bookings: top-level collection so customers and providers can query efficiently.
    match /bookings/{bookingId} {
      allow get: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
            || resource.data.companyId == request.auth.uid
            || isAdmin());

      allow list: if isAdmin()
        || (request.auth != null && resource.data.customerUid == request.auth.uid)
        || (request.auth != null && resource.data.companyId == request.auth.uid)
        || (request.auth != null && isPublicBookableCompany(resource.data.companyId))
        || (request.auth != null && hasProviderListing(resource.data.companyId));

      allow create: if isCustomerOnlineBooking()
        || (
          request.auth != null
          && request.resource.data.status == 'booked'
          && request.resource.data.companyId == request.auth.uid
          && isApprovedCompany(request.auth.uid)
          && request.resource.data.walkIn == true
          && request.resource.data.bookedByProviderUid == request.auth.uid
        );

      // Customer can cancel their own booking; provider can manage status for their company bookings.
      allow update: if request.auth != null
        && (
          // Provider/admin
          isAdmin()
          || (resource.data.companyId == request.auth.uid)
          // Customer cancel only (keep immutable linkage)
          || (
            resource.data.customerUid == request.auth.uid
            && request.resource.data.customerUid == resource.data.customerUid
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.slotId == resource.data.slotId
            && request.resource.data.serviceId == resource.data.serviceId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    // Unique account/username reservation for race-safe signup.
    match /accountNames/{nameId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Public provider directory (one doc per approved company). Used for customer browse/search.
    match /providers/{companyId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() || isApprovedCompany(companyId) || isProviderSelf(companyId);
      allow delete: if false;
    }

    // JCC payment sessions — Cloud Functions (Admin SDK) only.
    match /paymentSessions/{sessionId} {
      allow read, write: if false;
    }

    // Active subscriptions (renewed by scheduled Cloud Function).
    match /billingSubscriptions/{subId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Shop aggregate counters (written by Cloud Functions only).
    match /shopStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Contact form submissions — written by Cloud Functions; admins review in Admin tools.
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /customerPayments/{emailKey}/payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pet sharing between PetPal accounts (owner invites collaborator by email).
    match /petCollaborators/{shareId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.collaboratorUid == request.auth.uid
        || (request.auth.token.email != null && resource.data.collaboratorEmail == request.auth.token.email)
      );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Public profile docs used by NFC/QR pages (sanitized fields only).
    match /publicPets/{publicId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Stray / found pets available for adoption — visible to signed-in users; only reporter edits their doc.
    match /strayListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'available';
      allow update: if request.auth != null
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid == resource.data.reporterUid;
      allow delete: if false;
    }

    // Home Discover feed — public read; approved businesses and admins publish.
    match /discoverPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && (
          isAdmin()
          || ownerHasApprovedCompany(request.auth.uid)
        );
      allow update, delete: if isAdmin()
        || (request.auth != null
            && resource.data.authorUid == request.auth.uid
            && ownerHasApprovedCompany(request.auth.uid));
    }

    // Dog breeding listings — signed-in readers; owners update their docs only.
    match /breedingListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
