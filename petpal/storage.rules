rules_version = '2';
// Deploy with: firebase deploy --only storage (or Actions → Deploy storage rules)
// Requires Blaze plan for Storage, or use local-only profile photos in the app (no rules needed).
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{userId}/avatar.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 600 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /petPhotos/{userId}/{petId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /shopAssets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /companyLogos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
