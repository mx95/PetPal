# Copy to ".env.local" in this folder, fill values from Firebase project settings, then restart "yarn start".
# On the Hetzner server: set these BEFORE "npm run build" — Create React App bakes them into the bundle.

# Optional: set to 1 to auto-load demo pets when the saved pet list is empty (overrides NODE_ENV for staging demos).
# Set to 0 to disable demo auto-load even in development.
# REACT_APP_AUTO_LOAD_SAMPLE=1

# --- Firebase (required for auth) ---
# All six variables below are required for Auth/Firestore; leaving any empty causes Firebase to reject the web API key (auth/invalid-api-key) unless the app skips initialization when incomplete.
REACT_APP_FIREBASE_API_KEY=
# Production (petpal.com.cy): use the site domain (not *.firebaseapp.com) so Google
# redirect sign-in works on iOS Safari. The tracker proxies /__/auth → Firebase.
# Local yarn start: *.firebaseapp.com is fine.
REACT_APP_FIREBASE_AUTH_DOMAIN=petpal.com.cy
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Optional: Google Analytics (Web)
# REACT_APP_FIREBASE_MEASUREMENT_ID=

# --- Maps ---
# Nearby map: one key with Maps JavaScript API + Places API; restrict to your URLs (e.g. http://localhost:3000/*)
# REACT_APP_GOOGLE_MAPS_API_KEY=
# Tracker page map: uses Google when REACT_APP_GOOGLE_MAPS_API_KEY is set. Set osm for OpenStreetMap/Leaflet instead.
# REACT_APP_TRACKING_MAP=osm
# Optional: second key for server/CLI Places REST only — not used by the web bundle if named without REACT_APP_
# GOOGLE_PLACES_API_KEY=

# --- Tracker server (Xexun ingest on Hetzner) ---
# Required for live GPS tracking against your TCP server HTTP API.
# Use "same" when the React app is served from the same host:port as the API (typical PM2 setup on :5002).
# Example remote dev: REACT_APP_XEXUN_HTTP_BASE_URL=http://116.203.209.68:5002
# REACT_APP_XEXUN_HTTP_BASE_URL=same

# Admin device registry (/admin/devices) — must match TRACKER_ADMIN_TOKEN in /var/lib/petpal/tracker-admin.env on server
# REACT_APP_TRACKER_ADMIN_TOKEN=

# --- Wi‑Fi home tracking (Device tab, router BSSID, one-tap home map) ---
# Device tab: shown on http:// when REACT_APP_XEXUN_HTTP_BASE_URL is set (typical PM2 :5002 setup).
# One-tap "Set home on map" still needs HTTPS (browser geolocation) unless on localhost.
#
# When you serve the app over HTTPS, you can also set:
#   REACT_APP_TRACKING_WIFI_ENABLED=1
# Force off Device tab + Wi‑Fi UX:
#   REACT_APP_TRACKING_WIFI_ENABLED=0
# If REACT_APP_TRACKING_WIFI_ENABLED is unset: Device tab when tracker API env is set; geolocation on https:// only.

# --- Optional: other tracking backends ---
# REACT_APP_TRACKING_BFF_URL=
# REACT_APP_TRACKING_BFF_TOKEN=
# REACT_APP_PETPAL_VENDOR_BASE_URL=
# REACT_APP_PETPAL_VENDOR_USER=
# REACT_APP_PETPAL_VENDOR_PASS=

# --- Bookings ---
# Show Bookings in bottom nav, top nav, and discover (default on; set 0 to hide).
# REACT_APP_BOOKINGS_BROWSE=1

# Full guide: docs/TRACKING_SETUP.md
