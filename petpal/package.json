  "scripts": {
    "build:tw": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/tailwind.input.css -o ./src/tailwind.generated.css",
    "prestart": "npm run build:tw",
    "prebuild": "npm run build:tw",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:mobile:web": "node scripts/build-mobile-web.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
